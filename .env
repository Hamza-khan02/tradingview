# Port where TradingView Desktop's remote debugging is listening (started with --remote-debugging-port=9222)
TRADINGVIEW_DEBUG_PORT=9222

# Host where TradingView Desktop's remote debugging is listening
TRADINGVIEW_DEBUG_HOST=127.0.0.1

# Timeout for CDP commands in milliseconds
CDP_TIMEOUT_MS=10000

# Minimum log level to print to stderr (debug, info, warn, error)
LOG_LEVEL=info
